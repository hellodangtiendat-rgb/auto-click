<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:models="using:App1.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Auto Click Tool">

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU BÊN TRÁI -->
        <Border Grid.Column="0"
                Background="#252526"
                BorderBrush="#3A3A3D"
                BorderThickness="0,0,1,0">

            <StackPanel Padding="16" Spacing="10">

                <TextBlock Text="AUTO CLICK"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Button x:Name="ClickScriptMenuButton"
                        Content="📋 Kịch bản click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="ClickScriptMenuButton_Click"/>

                <Button x:Name="SettingsMenuButton"
                        Content="⚙ Cài đặt"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="SettingsMenuButton_Click"/>

            </StackPanel>
        </Border>

        <!-- NỘI DUNG BÊN PHẢI -->
        <Grid Grid.Column="1">

            <!-- PAGE: KỊCH BẢN CLICK -->
            <Grid x:Name="ClickScriptPage"
                  ColumnDefinitions="260,*">

                <!-- SIDEBAR: DANH SÁCH KỊCH BẢN -->
                <Border Grid.Column="0"
                        Background="#1A1A1A"
                        BorderBrush="#333333"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*">

                        <!-- Sidebar header -->
                        <Border Grid.Row="0"
                                Padding="10,11"
                                BorderBrush="#333333"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="4">

                                <!-- Toggle button ở đầu tiên — luôn hiện, không bị che -->
                                <Button x:Name="SidebarToggleButton"
                                        Grid.Column="0"
                                        Content="«"
                                        Padding="4,2"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        Click="SidebarToggleButton_Click"/>

                                <!-- Title (ẩn khi thu gọn) -->
                                <TextBlock x:Name="SidebarTitleText"
                                           Grid.Column="1"
                                           Text="KỊCH BẢN"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#888888"
                                           CharacterSpacing="80"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <!-- + button (ẩn khi thu gọn) -->
                                <Button x:Name="SidebarNewScriptButton"
                                        Grid.Column="2"
                                        Content="+"
                                        Padding="5,1"
                                        FontSize="16"
                                        FontWeight="Light"
                                        VerticalAlignment="Center"
                                        Click="NewScriptDialogButton_Click"/>
                            </Grid>
                        </Border>

                        <!-- Script list -->
                        <ListView x:Name="SavedScriptsListView"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind ScriptList, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectionChanged="SavedScriptsListView_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                    <Setter Property="FocusVisualMargin" Value="-1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ListViewItemPresenter
                                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Content="{TemplateBinding Content}"
                                                    Padding="{TemplateBinding Padding}"
                                                    PointerOverBackground="#2E2E2E"
                                                    PointerOverForeground="White"
                                                    SelectedBackground="#1B4F9A"
                                                    SelectedForeground="White"
                                                    SelectedPointerOverBackground="#16427F"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ScriptListItem">
                                    <Grid Padding="14,9"
                                          ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Name}"
                                                   Foreground="#CCCCCC"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4"
                                                    Visibility="{x:Bind ActionVisibility, Mode=OneWay}">
                                            <Button Content="Đổi tên"
                                                    Tag="{x:Bind}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Click="InlineRenameButton_Click"/>
                                            <Button Content="Xóa"
                                                    Tag="{x:Bind}"
                                                    Padding="8,3"
                                                    FontSize="12"
                                                    Click="InlineDeleteButton_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </Grid>
                </Border>

                <!-- MAIN: EDITOR AREA -->
                <Grid Grid.Column="1">

                    <!-- Placeholder khi chưa mở kịch bản -->
                    <StackPanel x:Name="ScriptEditorPlaceholder"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10">
                        <TextBlock Text="Chọn kịch bản để mở, hoặc tạo kịch bản mới"
                                   FontSize="15"
                                   Foreground="#555555"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Bấm đúp vào tên kịch bản để mở nhanh"
                                   FontSize="13"
                                   Foreground="#444444"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Editor (hiện khi có kịch bản đang mở) -->
                    <Grid x:Name="ScriptEditorPanel"
                          Visibility="Collapsed"
                          RowDefinitions="Auto,*">

                        <!-- Header bar -->
                        <Border Grid.Row="0"
                                Background="#252526"
                                BorderBrush="#333333"
                                BorderThickness="0,0,0,1"
                                Padding="20,11">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ScriptVM.ScriptDisplayName, Mode=OneWay}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind ScriptVM.AutoSaveStatus, Mode=OneWay}"
                                               FontSize="12"
                                               Foreground="#777777"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="HotkeyHintTextBlock"
                                           Grid.Column="1"
                                           Text=""
                                           FontSize="12"
                                           Foreground="#555555"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Body: Steps list + Run panel -->
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,290">

                            <!-- Steps area -->
                            <Grid Grid.Column="0"
                                  Padding="16"
                                  RowDefinitions="Auto,Auto,*"
                                  RowSpacing="10">

                                <!-- Toolbar -->
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Content="Thêm Click"
                                            Click="AddPointButton_Click"/>
                                    <Button Content="Thêm Delay"
                                            Click="AddDelayButton_Click"/>
                                    <Button Content="Xóa tất cả"
                                            Click="ClearListButton_Click"/>
                                </StackPanel>

                                <!-- Column headers -->
                                <Border Grid.Row="1"
                                        Background="#1E1E1E"
                                        CornerRadius="4"
                                        Padding="10,5">
                                    <Grid ColumnDefinitions="48,72,90,90,110,*,64"
                                          ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="#" Foreground="#666666" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="Loại" Foreground="#666666" FontSize="12"/>
                                        <TextBlock Grid.Column="2" Text="X" Foreground="#666666" FontSize="12"/>
                                        <TextBlock Grid.Column="3" Text="Y" Foreground="#666666" FontSize="12"/>
                                        <TextBlock Grid.Column="4" Text="Delay ms" Foreground="#666666" FontSize="12"/>
                                        <TextBlock Grid.Column="5" Text="Mô tả" Foreground="#666666" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Steps list -->
                                <ListView x:Name="ClickStepsListView"
                                          Grid.Row="2"
                                          ItemsSource="{x:Bind ScriptVM.ClickSteps, Mode=OneWay}"
                                          CanDragItems="True"
                                          CanReorderItems="True"
                                          AllowDrop="True"
                                          DragItemsCompleted="ClickStepsListView_DragItemsCompleted">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="10,3"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ClickStep">
                                            <Grid ColumnDefinitions="48,72,90,90,110,*,64"
                                                  ColumnSpacing="6">
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind IndexText, Mode=OneWay}"
                                                           Foreground="#777777"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind TypeText, Mode=OneWay}"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="2"
                                                         Text="{x:Bind XInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{x:Bind CoordVisibility, Mode=OneWay}"
                                                         FontSize="13"/>
                                                <TextBox Grid.Column="3"
                                                         Text="{x:Bind YInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{x:Bind CoordVisibility, Mode=OneWay}"
                                                         FontSize="13"/>
                                                <TextBox Grid.Column="4"
                                                         Text="{x:Bind DelayInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13"/>
                                                <TextBox Grid.Column="5"
                                                         Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="13"/>
                                                <Button Grid.Column="6"
                                                        Content="Xóa"
                                                        Tag="{x:Bind Id}"
                                                        Padding="6,3"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        Click="DeleteStepButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>

                            <!-- Run panel -->
                            <Border Grid.Column="1"
                                    Background="#1E1E1E"
                                    BorderBrush="#333333"
                                    BorderThickness="1,0,0,0"
                                    Padding="16">
                                <Grid RowDefinitions="Auto,Auto,Auto,*"
                                      RowSpacing="12">

                                    <TextBlock Text="Chạy kịch bản"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>

                                    <StackPanel Grid.Row="1" Spacing="10">
                                        <TextBox x:Name="LoopCountTextBox"
                                                 Header="Số vòng lặp"
                                                 Text="1"
                                                 TextChanged="LoopCountTextBox_TextChanged"/>
                                        <TextBlock Text="Nhập 0 để lặp vô hạn"
                                                   Foreground="#777777"
                                                   FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="RunScriptButton"
                                                    Content="{x:Bind ScriptVM.RunButtonLabel, Mode=OneWay}"
                                                    Width="100"
                                                    Click="RunScriptButton_Click"/>
                                            <Button Content="Xóa log"
                                                    Width="85"
                                                    Click="ClearLogButton_Click"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2"
                                               x:Name="RunStatusTextBlock"
                                               Text="{x:Bind ScriptVM.RunStatus, Mode=OneWay}"
                                               Foreground="#7CFC00"
                                               FontSize="13"/>

                                    <ScrollViewer Grid.Row="3"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBox x:Name="LogTextBox"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 FontFamily="Consolas"
                                                 FontSize="12"
                                                 Text=""/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- PAGE: CÀI ĐẶT -->
            <StackPanel x:Name="SettingsPage"
            Spacing="16"
            Padding="24"
            Visibility="Collapsed">

                <TextBlock Text="Cài đặt"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"/>

                <TextBlock Text="Thay đổi phím tắt cho các chức năng chính của tool."
               FontSize="16"
               Foreground="#CCCCCC"/>

                <Border Background="#2D2D30"
            CornerRadius="8"
            Padding="20"
            MaxWidth="680"
            HorizontalAlignment="Left">

                    <StackPanel Spacing="16">

                        <TextBlock Text="Phím tắt"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"/>

                        <TextBlock Text="Nên dùng các phím F1 - F12 để tránh ảnh hưởng khi nhập liệu."
                       Foreground="#CCCCCC"
                       FontSize="14"/>

                        <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="16">

                            <ComboBox x:Name="AddPointHotkeyComboBox"
                          Grid.Column="0"
                          Header="Thêm vị trí chuột vào kịch bản (F6)"/>

                            <ComboBox x:Name="RunScriptHotkeyComboBox"
                          Grid.Column="1"
                          Header="Start / Stop chạy kịch bản (F8)"/>

                        </Grid>

                        <StackPanel Orientation="Horizontal"
                        Spacing="10">

                            <Button Content="Lưu cài đặt"
                        Width="130"
                        Click="SaveHotkeySettingsButton_Click"/>

                            <Button Content="Khôi phục mặc định"
                        Width="160"
                        Click="ResetHotkeySettingsButton_Click"/>

                        </StackPanel>

                        <TextBlock x:Name="HotkeySettingsStatusTextBlock"
                       Text="Chưa thay đổi cài đặt."
                       Foreground="#7CFC00"
                       FontSize="14"/>

                        <Border Background="#1E1E1E"
                    CornerRadius="6"
                    Padding="12">

                            <TextBlock x:Name="CurrentHotkeyInfoTextBlock"
                           Text=""
                           Foreground="#CCCCCC"
                           FontSize="14"
                           TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Grid>
</Window>