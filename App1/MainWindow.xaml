<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:models="using:App1.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Auto Click Tool">

    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU BÊN TRÁI -->
        <Border Grid.Column="0"
                Background="#252526"
                BorderBrush="#3A3A3D"
                BorderThickness="0,0,1,0">

            <StackPanel Padding="16" Spacing="10">

                <TextBlock Text="AUTO CLICK"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,16"/>

                <Button x:Name="CoordinateMenuButton"
                        Content="📍 Lấy tọa độ"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="CoordinateMenuButton_Click"/>

                <Button x:Name="ClickScriptMenuButton"
                        Content="📋 Kịch bản click"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="ClickScriptMenuButton_Click"/>

                <Button x:Name="SettingsMenuButton"
                        Content="⚙ Cài đặt"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="SettingsMenuButton_Click"/>

            </StackPanel>
        </Border>

        <!-- NỘI DUNG BÊN PHẢI -->
        <Grid Grid.Column="1" Padding="24">

            <!-- PAGE: LẤY TỌA ĐỘ -->
            <StackPanel x:Name="CoordinatePage" Spacing="16">

                <TextBlock Text="Lấy tọa độ chuột"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="Theo dõi tọa độ chuột hiện tại trên màn hình."
                           FontSize="16"
                           Foreground="#CCCCCC"/>

                <Border Background="#2D2D30"
                        CornerRadius="8"
                        Padding="20"
                        MaxWidth="560"
                        HorizontalAlignment="Left">

                    <StackPanel Spacing="12">

                        <TextBlock Text="Tọa độ hiện tại"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">

                            <Border Grid.Column="0"
                                    Background="#3A3A3D"
                                    CornerRadius="6"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="X"
                                               Foreground="#AAAAAA"
                                               FontSize="14"/>
                                    <TextBlock x:Name="XTextBlock"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="32"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#3A3A3D"
                                    CornerRadius="6"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Y"
                                               Foreground="#AAAAAA"
                                               FontSize="14"/>
                                    <TextBlock x:Name="YTextBlock"
                                               Text="0"
                                               Foreground="White"
                                               FontSize="32"
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                        </Grid>

                        <TextBox x:Name="CoordinateTextBox"
                                 Text="X: 0, Y: 0"
                                 IsReadOnly="True"
                                 FontSize="18"/>

                        <TextBlock Text="Phím tắt: F6 = Thêm vị trí chuột vào kịch bản hiện tại, F7 = Start/Stop theo dõi, F8 = Start/Stop auto click"
                                   Foreground="#CCCCCC"
                                   FontSize="14"/>

                        <TextBlock x:Name="StatusTextBlock"
                                   Text="Đang theo dõi tọa độ..."
                                   Foreground="#7CFC00"
                                   FontSize="14"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">

                            <Button x:Name="StartStopButton"
                                    Content="Stop"
                                    Width="120"
                                    Click="StartStopButton_Click"/>

                            <Button Content="Copy tọa độ"
                                    Width="140"
                                    Click="CopyButton_Click"/>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- PAGE: KỊCH BẢN CLICK -->
            <Grid x:Name="ClickScriptPage"
                  Visibility="Collapsed"
                  RowDefinitions="Auto,*"
                  RowSpacing="16">

                <StackPanel Grid.Row="0" Spacing="8">
                    <TextBlock Text="Kịch bản click"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Tạo kịch bản, thêm điểm click thủ công hoặc dùng phím tắt F6 tại vị trí muốn click."
                               FontSize="16"
                               Foreground="#CCCCCC"/>

                    <TextBlock Text="Phím tắt: F6 = Thêm vị trí chuột vào kịch bản, F8 = Chạy/Dừng kịch bản"
                               FontSize="14"
                               Foreground="#CCCCCC"/>
                </StackPanel>

                <Grid Grid.Row="1">

                    <!-- MÀN HÌNH TẠO KỊCH BẢN -->
                    <Border x:Name="CreateScriptPanel"
                            Background="#2D2D30"
                            CornerRadius="8"
                            Padding="20"
                            MaxWidth="520"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">

                        <StackPanel Spacing="14">

                            <TextBlock Text="Tạo kịch bản mới"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock Text="Đầu tiên hãy đặt tên cho kịch bản click."
                                       Foreground="#CCCCCC"
                                       FontSize="14"/>

                            <TextBox x:Name="ScriptNameTextBox"
                                     Header="Tên kịch bản"
                                     PlaceholderText="Ví dụ: Login tool, Farm task, Click mở app..."/>

                            <Button Content="Tạo kịch bản"
                                    Width="150"
                                    Click="CreateScriptButton_Click"/>

                        </StackPanel>
                    </Border>

                    <!-- MÀN HÌNH CHỈNH SỬA KỊCH BẢN -->
                    <Grid x:Name="ScriptEditorPanel"
                          Visibility="Collapsed"
                          ColumnDefinitions="*,360"
                          ColumnSpacing="16">

                        <!-- DANH SÁCH ĐIỂM CLICK -->
                        <Border Grid.Column="0"
                                Background="#2D2D30"
                                CornerRadius="8"
                                Padding="16">

                            <Grid RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="12">

                                <StackPanel Grid.Row="0" Spacing="4">
                                    <TextBlock x:Name="CurrentScriptNameTextBlock"
                                               Text="Kịch bản: Chưa có"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>

                                    <TextBlock Text="F6 sẽ tự động thêm vị trí chuột hiện tại vào kịch bản này."
                                               FontSize="14"
                                               Foreground="#CCCCCC"/>
                                </StackPanel>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,*,*,Auto"
                                      ColumnSpacing="8">

                                    <TextBox x:Name="InputXTextBox"
         Grid.Column="0"
         Header="X"
         Text="0"/>

                                    <TextBox x:Name="InputYTextBox"
         Grid.Column="1"
         Header="Y"
         Text="0"/>

                                    <TextBox x:Name="InputDelayTextBox"
         Grid.Column="2"
         Header="Delay ms"
         Text="0"/>

                                    <StackPanel Grid.Column="3"
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Bottom">

                                        <Button Content="Thêm Click"
            Width="100"
            Click="AddPointButton_Click"/>

                                        <Button Content="Thêm Delay"
            Width="110"
            Click="AddDelayButton_Click"/>

                                    </StackPanel>

                                </Grid>

                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Spacing="8">

                                    <Button Content="Kịch bản mới"
                                            Width="130"
                                            Click="NewScriptButton_Click"/>

                                    <Button Content="Xóa danh sách"
                                            Width="130"
                                            Click="ClearListButton_Click"/>

                                </StackPanel>

                                <ListView x:Name="ClickStepsListView"
          Grid.Row="3"
          ItemsSource="{x:Bind ClickSteps, Mode=OneWay}"
          CanDragItems="True"
          CanReorderItems="True"
          AllowDrop="True"
          DragItemsCompleted="ClickStepsListView_DragItemsCompleted">

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ClickStep">
                                            <Grid ColumnDefinitions="60,90,110,110,130,*,80"
                  Padding="8"
                  ColumnSpacing="8">

                                                <TextBlock Grid.Column="0"
                           Text="{x:Bind IndexText, Mode=OneWay}"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                           Text="{x:Bind TypeText, Mode=OneWay}"
                           Foreground="White"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                                                <TextBox Grid.Column="2"
                         Text="{x:Bind XInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Header="X"/>

                                                <TextBox Grid.Column="3"
                         Text="{x:Bind YInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Header="Y"/>

                                                <TextBox Grid.Column="4"
                         Text="{x:Bind DelayInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Header="Delay ms"/>

                                                <TextBox Grid.Column="5"
                         Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Header="Mô tả"/>

                                                <Button Grid.Column="6"
                        Content="Xóa"
                        Tag="{x:Bind Id}"
                        VerticalAlignment="Bottom"
                        Click="DeleteStepButton_Click"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                            </Grid>
                        </Border>

                        <!-- CHẠY KỊCH BẢN + LOG -->
                        <Border Grid.Column="1"
                                Background="#2D2D30"
                                CornerRadius="8"
                                Padding="16">

                            <Grid RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="12">

                                <TextBlock Text="Chạy kịch bản"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>

                                <StackPanel Grid.Row="1"
                                            Spacing="10">

                                    <TextBox x:Name="LoopCountTextBox"
                                             Header="Số vòng lặp"
                                             Text="1"/>

                                    <TextBlock Text="Nhập 0 = lặp vô hạn"
                                               Foreground="#CCCCCC"
                                               FontSize="13"/>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">

                                        <Button x:Name="RunScriptButton"
                                                Content="Start"
                                                Width="100"
                                                Click="RunScriptButton_Click"/>

                                        <Button Content="Clear Log"
                                                Width="100"
                                                Click="ClearLogButton_Click"/>

                                    </StackPanel>

                                </StackPanel>

                                <TextBlock Grid.Row="2"
                                           x:Name="RunStatusTextBlock"
                                           Text="Chưa chạy"
                                           Foreground="#7CFC00"
                                           FontSize="14"/>

                                <ScrollViewer Grid.Row="3"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">

                                    <TextBox x:Name="LogTextBox"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             Text=""/>

                                </ScrollViewer>

                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </Grid>

            <!-- PAGE: CÀI ĐẶT -->
            <StackPanel x:Name="SettingsPage"
            Spacing="16"
            Visibility="Collapsed">

                <TextBlock Text="Cài đặt"
               FontSize="28"
               FontWeight="Bold"
               Foreground="White"/>

                <TextBlock Text="Thay đổi phím tắt cho các chức năng chính của tool."
               FontSize="16"
               Foreground="#CCCCCC"/>

                <Border Background="#2D2D30"
            CornerRadius="8"
            Padding="20"
            MaxWidth="680"
            HorizontalAlignment="Left">

                    <StackPanel Spacing="16">

                        <TextBlock Text="Phím tắt"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="White"/>

                        <TextBlock Text="Nên dùng các phím F1 - F12 để tránh ảnh hưởng khi nhập liệu."
                       Foreground="#CCCCCC"
                       FontSize="14"/>

                        <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="14">

                            <ComboBox x:Name="AddPointHotkeyComboBox"
                          Grid.Row="0"
                          Grid.Column="0"
                          Header="Thêm vị trí vào kịch bản"/>

                            <ComboBox x:Name="ToggleTrackingHotkeyComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Header="Start / Stop theo dõi tọa độ"/>

                            <ComboBox x:Name="RunScriptHotkeyComboBox"
                          Grid.Row="1"
                          Grid.Column="0"
                          Header="Start / Stop chạy kịch bản"/>

                            <ComboBox x:Name="CopyCoordinateHotkeyComboBox"
                          Grid.Row="1"
                          Grid.Column="1"
                          Header="Copy tọa độ hiện tại"/>

                        </Grid>

                        <StackPanel Orientation="Horizontal"
                        Spacing="10">

                            <Button Content="Lưu cài đặt"
                        Width="130"
                        Click="SaveHotkeySettingsButton_Click"/>

                            <Button Content="Khôi phục mặc định"
                        Width="160"
                        Click="ResetHotkeySettingsButton_Click"/>

                        </StackPanel>

                        <TextBlock x:Name="HotkeySettingsStatusTextBlock"
                       Text="Chưa thay đổi cài đặt."
                       Foreground="#7CFC00"
                       FontSize="14"/>

                        <Border Background="#1E1E1E"
                    CornerRadius="6"
                    Padding="12">

                            <TextBlock x:Name="CurrentHotkeyInfoTextBlock"
                           Text=""
                           Foreground="#CCCCCC"
                           FontSize="14"
                           TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>

        </Grid>
    </Grid>
</Window>